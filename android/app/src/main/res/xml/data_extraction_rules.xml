<?xml version="1.0" encoding="utf-8"?>
<!--
  داده‌های کاربر (فایل کتاب‌ها، پایگاه داده یادداشت‌ها و تنظیمات) نباید
  به‌صورت خودکار به فضای ابری یا دستگاه دیگری منتقل شوند. این با ادعای
  حریم خصوصی اپ هم‌راستاست: داده فقط روی دستگاه کاربر می‌ماند.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
