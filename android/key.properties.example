# ─────────────────────────────────────────────────────────────
#  فایل نمونه برای کلید امضای انتشار. این فایل را کپی نکن؛
#  به‌جایش یک کپی به نام key.properties بساز و مقادیر واقعی را بگذار.
#  key.properties در git نیست و نباید هرگز commit شود.
# ─────────────────────────────────────────────────────────────
#
#  ساخت کلید (یک‌بار برای همیشه — اگر کلید را گم کنی دیگر نمی‌توانی
#  نسخه به‌روزشده‌ای روی فروشگاه منتشر کنی، پس حتماً پشتیبان بگیر):
#
#    keytool -genkey -v -keystore ~/booka-release.jks \
#            -keyalg RSA -keysize 2048 -validity 10000 -alias booka
#
#  سپس کلید base64 شود تا متن خالص در ترمینال لو نرود:
#
#    base64 -i ~/booka-release.jks > ~/booka-release.jks.b64
#
#  مقادیر زیر را با خروجی دستورهای بالا پر کن:

storePassword=رمز-انبار-کلید
keyPassword=رمز-کلید
keyAlias=booka
storeFile=/مسیر/مطلق/تا/booka-release.jks
